# Amazon production SP-API app credentials
# Never commit real secrets. Add the real values in Vercel Project Settings > Environment Variables.
AMAZON_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SESSION_SECRET=

# Use draft while testing a production app; change to published after Appstore approval.
AMAZON_APP_STATUS=draft

# Must exactly match the OAuth Redirect URI registered in Solution Provider Portal.
AMAZON_REDIRECT_URI=https://cuteqr-weld.vercel.app/api/amazon/callback
